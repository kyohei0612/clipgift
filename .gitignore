# エンコーダ検出結果のキャッシュ。マシン固有（GPU 構成依存）なので絶対に配布しない。
# これを commit すると、開発機の h264_nvenc が全ユーザーに配られて
# NVIDIA GPU の無い環境でクリップ生成が全滅する。
bin/video_encoder.json
installer_output/
# installer_assets/ は親ごと除外せず、機密・大容量ファイルだけ個別除外
# （ClipGiftLog.ico / README.txt / LICENSE.txt は配布物として追跡したい）
installer_assets/python-3.10.0-amd64.exe
installer_assets/github_token.txt
installer_assets/*.exe
*.bak
server_start_count.txt
build_log.txt
build_err.txt
__pycache__/
*.pyc
.claude/
.update_in_progress
.env
.env.local
.env.*.local
sns_automation/.env
sns_automation/.env.local
sns_automation/.env.*.local
sns_automation/.history.json

# 内部組織管理（妻情報・戦略・本名等を含む、絶対に公開しない）
.company/

# ライセンス発行履歴・メール文（購入者の個人情報を含む、絶対に公開しない）
scripts/issued_keys/
scripts/.issued_keys.jsonl

# サポートセンター（受信メール本文・修正案・返信ログには個人情報を含む可能性）
# ⚠️ このリポジトリは public。build_and_push.bat は `git add -A` で
#    全ファイルを巻き込むため、作業ファイルをここに置くと即公開される。
#    実際 2026-08-16 に報告者のメールアドレス入りの返信下書きを公開してしまい、
#    履歴書き換えで消す羽目になった。返信下書き・返信ログの類は必ず除外する。
support_center/.env
support_center/.env.local
support_center/incoming/
support_center/draft_*.md
support_center/reply_*.md
support_center/replies/
support_center/outgoing/

# Cloudflare Workers ローカル開発（node_modules はサイズ大、コミット禁止）
license_server/node_modules/
license_server/.wrangler/

# ローカル一時ファイル
dl_progress.json

# Tauri ビルド成果物（target/ は 100MB+ になる、絶対 commit しない）
src-tauri/target/
src-tauri/Cargo.lock
src-tauri/build_output.log
src-tauri/gen/

# root の空 'build' ファイル混入対策（2026-05-21 v2.0.1/v2.0.2 で誤って commit された 0 byte ファイル）
# どこから出力されたか原因不明だが、auto_update が「ダウンロードしたファイルが空」エラーで止まるので除外
/build

# ローカルビルドの ClipGift.exe（root に置かれるが setup.iss は src-tauri/target/release から取得するので不要）
ClipGift.exe
launcher_window.log
