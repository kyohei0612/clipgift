# SNS 自動投稿システム 認証情報テンプレ
# このファイルは Git にコミット OK（値は空 or プレースホルダ）
# 実際の値は `.env` にコピーして書く（`.env` は gitignored）
#
# 本番運用は GitHub Secrets で管理（.github/workflows/sns_post.yml 参照）

# ============================================================
# Threads (Meta Graph API)
# ============================================================
# Meta Developer ダッシュボード:
#   マイアプリ → ClipgiftAutoPoster → ユースケース →
#   Threads APIにアクセス → カスタマイズ → 設定 → ユーザートークン生成ツール
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# ============================================================
# X (Twitter) - tweepy / OAuth 2.0
# ============================================================
# Twitter Developer Portal → Project & Apps → Keys and tokens
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ============================================================
# Bluesky (atproto)
# ============================================================
# Bluesky 設定 → App Passwords → 新規発行（メインPWとは別）
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
