# サポートセンター連携 設定例
# 使い方: このファイルを `.env` にコピーして値を埋める。`.env` は git 管理外。

# ────────────────────────────────────────────────────────────
# A. 受信用 IMAP（Phase 1 = Gmail / nekodori0612@gmail.com）
# ────────────────────────────────────────────────────────────
# Gmail 側準備:
#   1. https://myaccount.google.com/security で 2 段階認証を ON
#   2. https://myaccount.google.com/apppasswords でアプリパスワードを生成
#      （アプリ名は自由、生成された 16 文字をコピー）
SUPPORT_IMAP_HOST=imap.gmail.com
SUPPORT_IMAP_PORT=993
SUPPORT_MAIL_USER=nekodori0612@gmail.com
SUPPORT_MAIL_APP_PASSWORD=

# ────────────────────────────────────────────────────────────
# A'. Phase 2 / 本番（独自ドメイン）- 後日切り替え時に使う
# ────────────────────────────────────────────────────────────
# 上の Gmail 個人設定をコメントアウトして、こちらを有効化:
# SUPPORT_IMAP_HOST=imap.gmail.com
# SUPPORT_IMAP_PORT=993
# SUPPORT_MAIL_USER=support@clipgift.app  # Google Workspace 連携時
# SUPPORT_MAIL_APP_PASSWORD=

# ────────────────────────────────────────────────────────────
# B. Workers エンドポイント（kyohei 通知 / ユーザー返信送信用）
# ────────────────────────────────────────────────────────────
SUPPORT_WORKERS_ENDPOINT=https://clipgift-license.kyohei0612.workers.dev
# license_server で使っている ADMIN_BEARER_TOKEN と同じ値
SUPPORT_ADMIN_TOKEN=

# ────────────────────────────────────────────────────────────
# C. 件名フィルタ / ポーリング設定（通常は変更不要）
# ────────────────────────────────────────────────────────────
SUPPORT_SUBJECT_FILTER=【ClipGift エラー報告】
SUPPORT_POLL_INTERVAL=10

# ────────────────────────────────────────────────────────────
# D. Claude CLI（PATH に通っていれば変更不要）
# ────────────────────────────────────────────────────────────
CLAUDE_CLI_PATH=claude

# ────────────────────────────────────────────────────────────
# E. アプリ側送信先（通常は変更不要、Phase 2 で本番ドメイン切替時に変更）
# ────────────────────────────────────────────────────────────
# SUPPORT_REPORT_ENDPOINT=https://clipgift-license.kyohei0612.workers.dev/support/report
